# syntax=docker/dockerfile:1

FROM python:3.12-slim AS builder

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

RUN python -m venv "${VIRTUAL_ENV}"
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --no-compile --requirement /tmp/requirements.txt \
    && pip check

FROM apache/airflow:3.3.1-python3.12

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CREDIT_PYTHON=/opt/venv/bin/python \
    PYTHONPATH="/app:/app/src:/app/ml_prep_kit/src" \

ENV MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI:-sqlite:////app/data/processed/monitoring/mlflow.db} \
    MLFLOW_ARTIFACT_LOCATION=${MLFLOW_ARTIFACT_LOCATION:-}

ENV AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:-} \
    AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:-} \
    AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-}

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# As tarefas usarão CREDIT_PYTHON, preservando as dependências do próprio Airflow.
COPY --from=builder --chown=airflow:root /opt/venv /opt/venv
COPY --chown=airflow:root src /app/src
COPY --chown=airflow:root ml_prep_kit /app/ml_prep_kit

# Os dados entram pelo volume compartilhado definido no Compose.
USER airflow
WORKDIR /opt/airflow
